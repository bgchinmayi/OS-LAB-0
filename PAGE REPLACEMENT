#include<stdio.h>

int main()
{
    int p[20],n,f,i,j,found,fifoF=0,lruF=0,optF=0;

    printf("Enter no of pages: ");
    scanf("%d",&n);

    printf("Enter pages: ");
    for(i=0;i<n;i++) scanf("%d",&p[i]);

    printf("Enter no of frames: ");
    scanf("%d",&f);

    /* FIFO */
    int fifo[10],front=0;
    for(i=0;i<f;i++) fifo[i]=-1;

    for(i=0;i<n;i++){
        found=0;
        for(j=0;j<f;j++)
            if(fifo[j]==p[i]) found=1;
        if(!found){
            fifo[front]=p[i];
            front=(front+1)%f;
            fifoF++;
        }
    }


    int lru[10],t[10],cnt=0,pos;
    for(i=0;i<f;i++) lru[i]=-1,t[i]=0;

    for(i=0;i<n;i++){
        found=0;
        for(j=0;j<f;j++)
            if(lru[j]==p[i])
                found=1,t[j]=++cnt;

        if(!found){
            pos=0;
            for(j=1;j<f;j++)
                if(t[j]<t[pos]) pos=j;

            lru[pos]=p[i];
            t[pos]=++cnt;
            lruF++;
        }
    }

    int opt[10],far,next,idx;
    for(i=0;i<f;i++) opt[i]=-1;

    for(i=0;i<n;i++){
        found=0;
        for(j=0;j<f;j++)
            if(opt[j]==p[i]) found=1;

        if(!found){
            idx=0; far=-1;

            for(j=0;j<f;j++){
                for(next=i+1;next<n;next++)
                    if(opt[j]==p[next]) break;

                if(next>far){
                    far=next;
                    idx=j;
                }
            }

            opt[idx]=p[i];
            optF++;
        }
    }

    printf("\nFIFO=%d\nLRU=%d\nOPTIMAL=%d",fifoF,lruF,optF);

    return 0;
}
