#include <stdio.h>

int main()
{
    int nb, np, i, j;
    int block[20], process[20];
    int b1[20], b2[20], b3[20];
    int best, worst;

    printf("Enter number of blocks: ");
    scanf("%d", &nb);

    printf("Enter block sizes:\n");
    for(i = 0; i < nb; i++)
    {
        scanf("%d", &block[i]);
        b1[i] = b2[i] = b3[i] = block[i];
    }

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter process sizes:\n");
    for(i = 0; i < np; i++)
        scanf("%d", &process[i]);

    printf("\nFIRST FIT\n");
    for(i = 0; i < np; i++)
    {
        for(j = 0; j < nb; j++)
        {
            if(b1[j] >= process[i])
            {
                printf("P%d -> B%d\n", i+1, j+1);
                b1[j] -= process[i];
                break;
            }
        }
    }

    printf("\nBEST FIT\n");
    for(i = 0; i < np; i++)
    {
        best = -1;
        for(j = 0; j < nb; j++)
        {
            if(b2[j] >= process[i])
            {
                if(best == -1 || b2[j] < b2[best])
                    best = j;
            }
        }

        if(best != -1)
        {
            printf("P%d -> B%d\n", i+1, best+1);
            b2[best] -= process[i];
        }
    }

    printf("\nWORST FIT\n");
    for(i = 0; i < np; i++)
    {
        worst = -1;
        for(j = 0; j < nb; j++)
        {
            if(b3[j] >= process[i])
            {
                if(worst == -1 || b3[j] > b3[worst])
                    worst = j;
            }
        }

        if(worst != -1)
        {
            printf("P%d -> B%d\n", i+1, worst+1);
            b3[worst] -= process[i];
        }
    }

    return 0;
}
